{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Strizh",
	"version": "0.1.2",
	"identifier": "app.strizh.desktop",
	"build": {
		"beforeDevCommand": "cd ../web && ./scripts/dev",
		"beforeBuildCommand": "cd ../web && ./scripts/build",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../../web/build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Стриж",
				"width": 1100,
				"height": 720,
				"minWidth": 360,
				"minHeight": 480,
				"resizable": true,
				"center": true,
				"theme": "Dark",
				"backgroundColor": "#0b0e13"
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"connect-src": ["'self'", "ipc:", "http://ipc.localhost", "wss:", "ws:"],
				"img-src": "'self' data:",
				"style-src": "'self' 'unsafe-inline'",
				"script-src": "'self'"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "SocialNetworking",
		"shortDescription": "Jabber-клиент",
		"longDescription": "Стриж — кроссплатформенный клиент XMPP: прямой обмен сообщениями через ваш Jabber-сервер."
	}
}
