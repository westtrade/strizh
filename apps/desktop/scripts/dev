#!/usr/bin/env bash
# tauri dev: поднимает Vite из apps/web (beforeDevCommand в tauri.conf.json)
# и открывает окно с WebView. Rust-компилятор обязателен.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=_pkgconfig.sh
. ./scripts/_pkgconfig.sh

# `command -v cargo` недостаточно: в asdf-среде шим есть всегда, а без
# назначенной версии rust он падает с кодом 126. Проверяем настоящий запуск.
if ! cargo --version >/dev/null 2>&1; then
  cat >&2 <<'EOF'
нужен рабочий Rust-тулчейн: https://rustup.rs
в asdf-среде версия не назначена — выполните из корня репозитория:
  asdf local rust 1.99.1     (либо добавьте строку в .tool-versions)
EOF
  exit 1
fi

# Системные библиотеки проверяем до компиляции: cargo иначе собирает 240
# крейтов и падает на libdbus-sys через пять минут. Шимы нужны и здесь:
# dev-пакетов может не быть, а рантайм-библиотеки — быть.
desktop_ensure_pkgconfig

exec ./node_modules/.bin/tauri dev "$@"
