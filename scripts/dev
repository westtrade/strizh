#!/usr/bin/env bash
# Поднимает локальную среду разработки в выбранных юнитах.
#   make dev                       только apps/web — единственный dev-сервер
#   make dev ARGS="desktop"        окно Tauri (Vite поднимет beforeDevCommand)
#   make dev ARGS="mobile"         приложение на Android-устройстве
#   make dev ARGS="--all"          все юниты, включая packages/
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=_units.sh
. ./scripts/_units.sh

# Как запускать dev в юните, у которого нет своей цели dev.
# Правится под проект: это единственное место, знающее команду запуска.
unit_dev_fallback() {
  local dir=$1
  if [ -f "$dir/vite.config.ts" ]; then
    ( cd "$dir" && exec bunx vite dev )
  else
    printf '==> %s: долгоживущего dev-сервера нет\n' "$dir" >&2
  fi
}

# Без селектора поднимаем только web. Причина не в лени: desktop и mobile —
# оболочки над тем же Vite-сервером, порт 5173 у них общий, и запуск «всех
# приложений» означал бы три драки за один порт. Оболочки стартуют по имени.
if [ $# -eq 0 ]; then
  set -- web
fi

units_run dev "$@"
