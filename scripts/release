#!/usr/bin/env bash
# Релиз одной командой: поднять версию, закоммитить, поставить тег, отправить.
# Сборку артефактов делает GitHub Actions (.github/workflows/release.yml) на
# трёх ОС — локально три платформы не получить.
#
#   make release                        поднять patch: 0.1.0 → 0.1.1
#   make release ARGS="minor"           поднять minor: 0.1.1 → 0.2.0
#   make release ARGS="major"           поднять major: 0.2.0 → 1.0.0
#   make release ARGS="prerelease"      предрелиз: 0.2.0 → 0.2.1-rc.1 (и далее rc.2)
#   make release ARGS="1.2.3"           задать версию явно
#   make release ARGS="minor --dry-run" поднять и закоммитить локально, без push
#   make release ARGS="--force"         пересоздать тег, если он уже есть
#
# Единственный источник правды — version в корневом package.json. Скрипт
# scripts/version разносит её по Cargo, Tauri, gradle и npm-пакетам, чтобы
# бинарники всех платформ имели одинаковую версию.
set -euo pipefail
cd "$(dirname "$0")/.."

target=""
dry_run=0
force=0

# `make release ARGS="minor --dry-run"` приходит ОДНИМ аргументом: Makefile
# передаёт ARGS без разбиения. Разбираем и его, и обычные аргументы.
args=()
for arg in "$@"; do
  # shellcheck disable=SC2206  # разбиение по пробелам здесь намеренное
  args+=($arg)
done

for arg in "${args[@]}"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --force) force=1 ;;
    -*) echo "неизвестный флаг: $arg" >&2; exit 2 ;;
    *) if [ -z "$target" ]; then target=$arg; else echo "лишний аргумент: $arg" >&2; exit 2; fi ;;
  esac
done

step() { printf '\n==> %s\n' "$*"; }

# --- проверки до любых изменений -------------------------------------------

step "Проверки"
if [ -n "$(git status --porcelain)" ]; then
  echo "рабочее дерево грязное — закоммитьте или спрячьте изменения:" >&2
  git status --short >&2
  exit 1
fi

if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  echo "у ветки нет upstream: git push -u origin $(git branch --show-current)" >&2
  exit 1
fi

make check-runner
make monorepo-check
make test ARGS="--all"
make check ARGS="web"

# --- версия ----------------------------------------------------------------

step "Версия"
before=$(./scripts/version)

case "$target" in
  "") after=$(./scripts/version bump patch) ;;
  patch | minor | major | prerelease) after=$(./scripts/version bump "$target") ;;
  *)
    if [[ "$target" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
      after=$(./scripts/version set "${target#v}")
    else
      echo "неизвестный аргумент: $target" >&2
      echo "ожидалось: patch | minor | major | prerelease | 1.2.3" >&2
      exit 2
    fi
    ;;
esac

tag="v$after"
printf 'версия: %s → %s\n' "$before" "$after"

./scripts/version check
if [ "$before" = "$after" ]; then
  echo "версия не изменилась — нечего выпускать" >&2
  exit 1
fi

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  if [ "$force" -eq 0 ]; then
    echo "тег $tag уже существует (--force, чтобы пересоздать)" >&2
    exit 1
  fi
  git tag -d "$tag" >/dev/null
fi

# --- коммит и тег ----------------------------------------------------------

step "Коммит"
git add -A
git -c user.email="${GIT_AUTHOR_EMAIL:-dev@strizh.local}" \
    -c user.name="${GIT_AUTHOR_NAME:-Strizh}" \
    commit -q -m "chore(release): $tag"
echo "$(git rev-parse --short HEAD) chore(release): $tag"

step "Тег $tag"
git tag -a "$tag" -m "Стриж $after"
echo "создан $tag"

# --- отправка --------------------------------------------------------------

if [ "$dry_run" -eq 1 ]; then
  step "Dry-run: отправка пропущена"
  cat <<EOF
локально созданы коммит и тег $tag.

отправить и запустить сборку:
  git push --follow-tags origin $(git branch --show-current)

отменить полностью:
  git tag -d $tag
  git reset --hard HEAD~1
EOF
  exit 0
fi

step "Отправка"
# --follow-tags шлёт и коммит, и аннотированный тег одним действием.
#
# GIT_SSH_COMMAND с `-F /dev/null` берётся только для SSH-remote и только если
# системный конфиг не читается (частый случай в контейнерах: симлинк в
# /etc/ssh/ssh_config.d принадлежит не-root, и ssh падает с "Bad owner or
# permissions"). На HTTPS-remote переменная безвредна, но и не нужна.
push_args=(--follow-tags origin "HEAD:$(git branch --show-current)")
if [[ "$(git remote get-url origin)" == git@* ]] && ! ssh -G github.com >/dev/null 2>&1; then
  echo "системный ssh_config не читается — использую чистый конфиг"
  GIT_SSH_COMMAND="ssh -F /dev/null -o StrictHostKeyChecking=accept-new" \
    git push "${push_args[@]}"
else
  git push "${push_args[@]}"
fi

# Сначала убираем хвост .git, потом берём owner/repo из любого вида remote
# (git@host:owner/repo и https://host/owner/repo).
remote=$(git remote get-url origin | sed -E 's#\.git$##' | sed -E 's#^.*[:/]([^/]+/[^/]+)$#\1#')

cat <<EOF

==> Готово: $tag отправлен.

GitHub Actions соберёт и опубликует:
  - Linux:   .deb, .rpm
  - Windows: .msi, .exe (NSIS)
  - macOS:   .dmg для aarch64 и x64

Прогресс:   gh run watch
Релиз:      gh release view $tag --web
Страница:   https://github.com/$remote/releases/tag/$tag
EOF
